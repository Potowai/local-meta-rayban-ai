<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />
    <!-- Foreground Service for Wake Word Detection -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Background Running -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".LocalMetaApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalMeta"
        tools:targetApi="31">

        <!-- Meta Wearables DAT Configuration -->
        <!--
          These two meta-data values are issued by the Meta Wearables
          Developer Center (https://wearables.developer.meta.com/) when you
          create a project. They tie your APK to your Meta developer
          account so the Meta AI companion app can authorize pairing.

          APPLICATION_ID : 16-digit numeric project ID
          CLIENT_TOKEN   : 32-digit hex token tied to the application

          For local builds these are baked in. For CI/release builds,
          consider moving them to gradle.properties so they are not
          committed (the values here belong to the public "demo" project
          of Alexis FIOLLEAU Team's account, visible on GitHub anyway).
        -->
        <meta-data
            android:name="com.meta.wearable.mwdat.APPLICATION_ID"
            android:value="1757925002093574" />
        <meta-data
            android:name="com.meta.wearable.mwdat.CLIENT_TOKEN"
            android:value="1b11757925002093574ef1748891ce14c4ab432b4815c1385638d" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LocalMeta">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep linking for Meta AI OAuth callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="localmeta" />
            </intent-filter>
        </activity>

        <!-- FileProvider for sharing photos -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Porcupine Wake Word Detection Service -->
        <service
            android:name=".services.PorcupineWakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Quick Vision Service -->
        <service
            android:name=".services.QuickVisionService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
